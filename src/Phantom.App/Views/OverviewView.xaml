<UserControl x:Class="Phantom.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Phantom.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="TopProcessTemplate">
            <Button Style="{StaticResource Button.Ghost}" Height="Auto" Padding="8,6" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.InspectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Key}" ToolTip="Inspect this process">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{StaticResource Brush.Text}">
                            <Run Text="{Binding Name, Mode=OneWay}" />
                            <Run Text="{Binding Pid, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource Text.Mono}" Margin="12,0,0,0" />
                    </Grid>
                    <Grid Height="3" Margin="0,5,0,0">
                        <Border Background="{StaticResource Brush.Border}" CornerRadius="1.5" />
                        <Border Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Fraction}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- Live metric cards -->
            <ItemsControl ItemsSource="{Binding Cards}" Margin="-6,-6,-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="6" Padding="16,14,16,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Stroke}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Value}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <ctl:LineChart Height="46" Margin="0,10,0,0" ShowGrid="False"
                                               Values="{Binding Values}" Values2="{Binding Values2}"
                                               Stroke="{Binding Stroke}" Stroke2="{Binding Stroke2}"
                                               Maximum="{Binding Maximum}"
                                               Capacity="{Binding DataContext.ChartCapacity, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding GpuNote, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Text="{Binding GpuNote}" />
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- Utilisation chart -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="Resource utilization" Style="{StaticResource Text.SectionTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.Cpu}" />
                                <TextBlock Text="CPU" Style="{StaticResource Text.Label}" Margin="0,0,16,0" />
                                <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.Memory}" />
                                <TextBlock Text="Memory" Style="{StaticResource Text.Label}" />
                            </StackPanel>
                        </Grid>
                        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <TextBlock Text="older" Style="{StaticResource Text.Muted}" FontSize="11" />
                            <TextBlock Text="now" Style="{StaticResource Text.Muted}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,12,0,0" MinHeight="190">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,8,0">
                                <TextBlock Text="100%" Style="{StaticResource Text.Muted}" FontSize="11" VerticalAlignment="Top" />
                                <TextBlock Text="50%" Style="{StaticResource Text.Muted}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="0%" Style="{StaticResource Text.Muted}" FontSize="11" VerticalAlignment="Bottom" />
                            </Grid>
                            <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
                                <ctl:LineChart Values="{Binding CpuSeries}" Values2="{Binding MemorySeries}"
                                               Stroke="{StaticResource Brush.Series.Cpu}" Stroke2="{StaticResource Brush.Series.Memory}"
                                               Maximum="100" Capacity="{Binding ChartCapacity}" GridBrush="{StaticResource Brush.Border}" />
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Hardware -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hardware" Style="{StaticResource Text.SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Hardware}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Field.Label}" Margin="0,8,0,1" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Body}" FontSize="12.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="8,16,8,10">
                    <StackPanel>
                        <TextBlock Text="Top CPU consumers" Style="{StaticResource Text.SectionTitle}" Margin="8,0,8,6" />
                        <ItemsControl ItemsSource="{Binding TopCpu}" ItemTemplate="{StaticResource TopProcessTemplate}" Tag="{StaticResource Brush.Series.Cpu}" />
                        <TextBlock Text="No process is using measurable CPU right now." Style="{StaticResource Text.Muted}" Margin="8,4"
                                   Visibility="{Binding TopCpu.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,16,8,10">
                    <StackPanel>
                        <TextBlock Text="Top memory consumers" Style="{StaticResource Text.SectionTitle}" Margin="8,0,8,6" />
                        <ItemsControl ItemsSource="{Binding TopMemory}" ItemTemplate="{StaticResource TopProcessTemplate}" Tag="{StaticResource Brush.Series.Memory}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recent activity" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding Marker}" VerticalAlignment="Top" Margin="0,5,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,1,10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource Text.Body}" FontSize="12.5" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No activity recorded yet." Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding RecentEvents.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
