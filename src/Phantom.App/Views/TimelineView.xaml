<UserControl x:Class="Phantom.App.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8,16,10">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBox Width="260" Tag="Search process, PID or description" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="170" Margin="12,0,0,0" ItemsSource="{Binding RangeOptions}" SelectedIndex="{Binding RangeIndex}" />
                    <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding ReloadCommand}" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsOn}" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Dot}" Width="7" Height="7" Fill="{Binding Marker}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Label}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsCustomRange, Converter={StaticResource Vis}}">
                    <TextBlock Text="From" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="150" Tag="yyyy-mm-dd hh:mm" Text="{Binding CustomFrom, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="to" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="10,0,8,0" />
                    <TextBox Width="150" Tag="yyyy-mm-dd hh:mm" Text="{Binding CustomTo, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Apply" Style="{StaticResource Button.Accent}" Command="{Binding ApplyCustomRangeCommand}" Margin="10,0,0,0" />
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding ShiftEarlierCommand}" ToolTip="Move the window earlier by its own length" Margin="10,0,0,0">
                        <TextBlock Text="&#xE76B;" Style="{StaticResource Text.Icon}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding ShiftLaterCommand}" ToolTip="Move the window later by its own length">
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Text.Icon}" FontSize="12" />
                    </Button>
                    <TextBlock Text="{Binding RangeError}" Foreground="{StaticResource Brush.Danger}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,8">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Label}" />
            <TextBlock Text="{Binding SourceNote}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
        </Grid>

        <ListBox Grid.Row="2" Style="{StaticResource List.Plain}" ItemsSource="{Binding Items}" Margin="8,0,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Mono}" />
                            <TextBlock Text="{Binding Date}" Style="{StaticResource Text.Muted}" FontSize="11" />
                        </StackPanel>
                        <Ellipse Grid.Column="1" Style="{StaticResource Dot}" Fill="{Binding Marker}" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource Text.Label}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{Binding Process}" Style="{StaticResource Text.Muted}" FontSize="11" Visibility="{Binding Process, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <Border Grid.Column="4" VerticalAlignment="Top" Margin="12,0,8,0" Padding="7,2" CornerRadius="9"
                                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" ToolTip="{Binding ProvenanceHint}">
                            <TextBlock Text="{Binding Provenance}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInferred}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel LastChildFill="False">
                <Button Content="Load older events" Command="{Binding LoadMoreCommand}" />
                <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="NoWrap"
                           Text="Observed = exact time from Windows.  Inferred = deduced between samples; very short-lived processes can be missed." />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
