<UserControl x:Class="Phantom.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Phantom.App.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <TextBox Width="260" Tag="Search name, PID or path" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="All" GroupName="ProcessFilter"
                                 IsChecked="{Binding FilterIndex, Converter={StaticResource IndexToBool}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="My processes" GroupName="ProcessFilter"
                                 IsChecked="{Binding FilterIndex, Converter={StaticResource IndexToBool}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="System" GroupName="ProcessFilter"
                                 IsChecked="{Binding FilterIndex, Converter={StaticResource IndexToBool}, ConverterParameter=2}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Refresh now" Command="{Binding RefreshCommand}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="ProcessGrid" Grid.Row="1" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}" Sorting="OnSorting">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230" MinWidth="120" ElementStyle="{StaticResource Cell.Text}" />
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" ElementStyle="{StaticResource Cell.Number}" HeaderStyle="{StaticResource Header.Number}" />
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="CpuSort" SortDirection="Descending" Width="80" ElementStyle="{StaticResource Cell.Number}" HeaderStyle="{StaticResource Header.Number}" />
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100" ElementStyle="{StaticResource Cell.Number}" HeaderStyle="{StaticResource Header.Number}" />
                <DataGridTextColumn Header="Private" Binding="{Binding PrivateText}" SortMemberPath="PrivateSort" Width="100" ElementStyle="{StaticResource Cell.Number}" HeaderStyle="{StaticResource Header.Number}" />
                <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="84" ElementStyle="{StaticResource Cell.Number}" HeaderStyle="{StaticResource Header.Number}" />
                <DataGridTextColumn Header="Handles" Binding="{Binding HandlesText}" SortMemberPath="HandlesSort" Width="90" ElementStyle="{StaticResource Cell.Number}" HeaderStyle="{StaticResource Header.Number}" />
                <DataGridTextColumn Header="Account" Binding="{Binding OwnerText}" Width="92" ElementStyle="{StaticResource Cell.Text}" />
                <DataGridTextColumn Header="Arch" Binding="{Binding ArchitectureText}" Width="70" ElementStyle="{StaticResource Cell.Text}" />
                <DataGridTextColumn Header="Started" Binding="{Binding StartText}" SortMemberPath="StartSort" Width="140" ElementStyle="{StaticResource Cell.Text}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Grid.Column="1" Width="330" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
            <Grid>
                <v:ProcessDetailPanel DataContext="{Binding Detail}" />
                <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                        Command="{Binding ClearSelectionCommand}" ToolTip="Close details">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" FontSize="12" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
