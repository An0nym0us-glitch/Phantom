<UserControl x:Class="Phantom.App.Views.SystemMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Phantom.App.Controls"
             xmlns:v="clr-namespace:Phantom.App.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Map toolbar -->
        <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <TextBox x:Name="SearchBox" Width="230" Tag="Search by name or PID — Enter for next"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown" />
                <TextBlock x:Name="MatchText" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="70" />

                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="All" GroupName="MapFilter"
                                 IsChecked="{Binding FilterIndex, Converter={StaticResource IndexToBool}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="My processes" GroupName="MapFilter"
                                 IsChecked="{Binding FilterIndex, Converter={StaticResource IndexToBool}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource Chip.Radio}" Content="System" GroupName="MapFilter"
                                 IsChecked="{Binding FilterIndex, Converter={StaticResource IndexToBool}, ConverterParameter=2}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}" Content="Collapse all" Command="{Binding CollapseAllCommand}" ToolTip="Collapse every process tree to its root" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Expand all" Command="{Binding ExpandAllCommand}" />
                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="8,4" />
                    <Button Style="{StaticResource Button.Ghost}" Click="OnZoomOut" ToolTip="Zoom out (−)">
                        <TextBlock Text="&#xE71F;" Style="{StaticResource Text.Icon}" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.TextSecondary}"
                               Width="44" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Ghost}" Click="OnZoomIn" ToolTip="Zoom in (+)">
                        <TextBlock Text="&#xE8A3;" Style="{StaticResource Text.Icon}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Content="Fit" Click="OnFit" ToolTip="Show the whole map (0)" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Focus" Click="OnFocusSelected" ToolTip="Centre on the selected process"
                            IsEnabled="{Binding Detail.HasProcess}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Reset layout" Click="OnResetLayout" ToolTip="Undo manual node moves and refit" />
                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="8,4" />
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding ToggleInspectorCommand}" ToolTip="Show or hide the inspector">
                        <TextBlock Text="&#xE8A0;" Style="{StaticResource Text.Icon}" FontSize="14" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Canvas -->
        <Grid Grid.Row="1">
            <ctl:SystemMapCanvas x:Name="Map" Scene="{Binding Scene}" SelectedKey="{Binding SelectedKey, Mode=TwoWay}" SearchText="{Binding SearchText}" />

            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Padding="12,8" CornerRadius="6"
                    Background="#E61C1F24" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" IsHitTestVisible="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CPU" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,8,0" />
                        <Border Width="110" Height="6" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF3D4754" Offset="0" />
                                    <GradientStop Color="#FF4C9AFF" Offset="0.35" />
                                    <GradientStop Color="#FFE0A93B" Offset="0.68" />
                                    <GradientStop Color="#FFE5604D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="idle → busy" Style="{StaticResource Text.Muted}" FontSize="11" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"
                               Text="Node size = memory  ·  light ring = your processes  ·  dashed ring = collapsed" />
                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0"
                               Text="Drag to pan  ·  wheel to zoom  ·  drag a node to move it  ·  double-click to collapse" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" IsHitTestVisible="False" />
        </Grid>

        <!-- Inspector -->
        <Border Grid.Row="1" Grid.Column="1" Width="320" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
                Visibility="{Binding InspectorOpen, Converter={StaticResource Vis}}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10"
                        Visibility="{Binding Detail.HasProcess, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Collapse / expand" Command="{Binding ToggleSelectedCommand}" Margin="0,0,8,0" />
                        <Button Content="Open in Processes"
                                Command="{Binding DataContext.InspectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding SelectedKey}" />
                    </StackPanel>
                </Border>
                <v:ProcessDetailPanel DataContext="{Binding Detail}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
