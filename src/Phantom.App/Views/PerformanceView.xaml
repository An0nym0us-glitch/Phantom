<UserControl x:Class="Phantom.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Phantom.App.Controls">
    <UserControl.Resources>
        <Style x:Key="ChartFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- CPU -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.Cpu}" />
                                <TextBlock Text="CPU" Style="{StaticResource Text.SectionTitle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource Text.Label}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CpuValue}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                            <TextBlock Text="overall utilization" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource ChartFrame}">
                        <ctl:LineChart Height="170" Values="{Binding CpuSeries}" Stroke="{StaticResource Brush.Series.Cpu}"
                                       Maximum="100" Capacity="{Binding ChartCapacity}" GridBrush="{StaticResource Brush.Border}" />
                    </Border>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="{Binding IntervalNote}" Style="{StaticResource Text.Muted}" FontSize="11" />
                        <TextBlock Text="0 – 100%" Style="{StaticResource Text.Muted}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="Logical processors" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding Cores}" Margin="-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="124" Margin="4" Padding="10,8" Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" FontSize="11" />
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Mono}" FontSize="11" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Height="4" Margin="0,6,0,0">
                                            <Border Background="{StaticResource Brush.Border}" CornerRadius="2" />
                                            <Border Background="{StaticResource Brush.Series.Cpu}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Percent, Converter={StaticResource ToScale}}" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,8,0,0"
                               Text="Utilization is measured from kernel processor times (share of time not idle). Task Manager reports frequency-scaled “utility”, so its figure can differ slightly, especially with turbo boost or power saving." />
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Memory -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.Memory}" />
                                <TextBlock Text="Memory" Style="{StaticResource Text.SectionTitle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MemoryValue}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Style="{StaticResource ChartFrame}">
                            <ctl:LineChart Height="120" Values="{Binding MemorySeries}" Stroke="{StaticResource Brush.Series.Memory}"
                                           Maximum="100" Capacity="{Binding ChartCapacity}" GridBrush="{StaticResource Brush.Border}" />
                        </Border>
                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="In use" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding MemoryUsed}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Available" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding MemoryAvailable}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Total physical" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding MemoryTotal}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.Gpu}" />
                                <TextBlock Text="GPU" Style="{StaticResource Text.SectionTitle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GpuValue}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding GpuNotice, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Text="{Binding GpuNotice}" />
                        </Border>
                        <Border Style="{StaticResource ChartFrame}" Visibility="{Binding GpuNotice, Converter={StaticResource Vis}, ConverterParameter=invert}">
                            <ctl:LineChart Height="120" Values="{Binding GpuSeries}" Stroke="{StaticResource Brush.Series.Gpu}"
                                           Maximum="100" Capacity="{Binding ChartCapacity}" GridBrush="{StaticResource Brush.Border}" />
                        </Border>
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Dedicated memory in use" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding GpuDedicated}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Shared memory in use" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="{Binding GpuShared}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Adapters" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding GpuAdapters}" Style="{StaticResource Text.Body}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Disk -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.Disk}" />
                                <TextBlock Text="Disk" Style="{StaticResource Text.SectionTitle}" />
                                <TextBlock Text="all physical disks" Style="{StaticResource Text.Muted}" Margin="8,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DiskValue}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                                <TextBlock Text="active time" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding DiskNotice, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Text="{Binding DiskNotice}" />
                        </Border>
                        <Border Style="{StaticResource ChartFrame}">
                            <ctl:LineChart Height="120" Values="{Binding DiskReadSeries}" Values2="{Binding DiskWriteSeries}"
                                           Stroke="{StaticResource Brush.Series.Disk}" Stroke2="{StaticResource Brush.Series.DiskWrite}"
                                           Capacity="{Binding ChartCapacity}" GridBrush="{StaticResource Brush.Border}" />
                        </Border>
                        <TextBlock Text="{Binding DiskPeak}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.Disk}" Width="6" Height="6" />
                                    <TextBlock Text="Read" Style="{StaticResource Text.Muted}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DiskRead}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.DiskWrite}" Width="6" Height="6" />
                                    <TextBlock Text="Write" Style="{StaticResource Text.Muted}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DiskWrite}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.NetDown}" />
                                <TextBlock Text="Network" Style="{StaticResource Text.SectionTitle}" />
                                <TextBlock Text="all active adapters" Style="{StaticResource Text.Muted}" Margin="8,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding NetValue}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                                <TextBlock Text="download" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource ChartFrame}">
                            <ctl:LineChart Height="120" Values="{Binding NetDownSeries}" Values2="{Binding NetUpSeries}"
                                           Stroke="{StaticResource Brush.Series.NetDown}" Stroke2="{StaticResource Brush.Series.NetUp}"
                                           Capacity="{Binding ChartCapacity}" GridBrush="{StaticResource Brush.Border}" />
                        </Border>
                        <TextBlock Text="{Binding NetPeak}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.NetDown}" Width="6" Height="6" />
                                    <TextBlock Text="Download" Style="{StaticResource Text.Muted}" />
                                </StackPanel>
                                <TextBlock Text="{Binding NetDown}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Dot}" Fill="{StaticResource Brush.Series.NetUp}" Width="6" Height="6" />
                                    <TextBlock Text="Upload" Style="{StaticResource Text.Muted}" />
                                </StackPanel>
                                <TextBlock Text="{Binding NetUp}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Adapters" Style="{StaticResource Text.Muted}" Margin="0,10,0,2" />
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Body}" FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding Type, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                                    <Setter Property="Text" Value="Disconnected" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                            <Setter Property="Text" Value="Connected" />
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Good}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
