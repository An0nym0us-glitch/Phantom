<Application x:Class="Phantom.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Phantom.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <c:VisibilityConverter x:Key="Vis" />
            <c:InverseBooleanConverter x:Key="Not" />
            <c:IndexToBoolConverter x:Key="IndexToBool" />
            <c:PercentToScaleConverter x:Key="ToScale" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
